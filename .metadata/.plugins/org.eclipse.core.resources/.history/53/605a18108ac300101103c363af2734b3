<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="model.ExpensesCalendar"%>
<%
	ExpensesCalendar ec=(ExpensesCalendar)request.getAttribute("ec");
%>
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%=ec.getGengou() %>年<%=ec.getMonth() %>月カレンダー</title>
  <link rel="stylesheet"  href="http://yui.yahooapis.com/3.18.1/build/cssreset/cssreset-min.css">
  <link href="https://fonts.googleapis.com/css?family=M+PLUS+Rounded+1c" rel="stylesheet">
  <link rel="stylesheet"  href="css/main.css">
</head>
<body>
  <div id="container">
  	<div class="header">
		<a href="?year=<%=ec.getYear()%>&month=<%=ec.getMonth()-1%>">⇦</a>
		<h1><%=ec.getGengou() %>年<%=ec.getMonth() %>月</h1>
    	<a href="?year=<%=ec.getYear()%>&month=<%=ec.getMonth()+1%>">⇨</a>
  	</div>
    <table id="calendar">
      <tr>
        <th>日</th>
        <th>月</th>
        <th>火</th>
        <th>水</th>
        <th>木</th>
        <th>金</th>
        <th>土</th>
      </tr>
      <%for(String[] row: ec.getData()){ %>
      <tr>
      	<%for(String col:row) {%>
      		<%if (col.startsWith("*")){ %>
      			<td class="today"><%=col.substring(1)%></td>
      		<%}else{ %>
      			<td><%=col %></td>
      		<%} %>
      	<%} %>
      </tr>
      <%} %>
    </table><!-- end calendar -->
  </div><!-- end container-->
</body>
</html>