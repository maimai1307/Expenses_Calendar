@charset "UTF-8";
body{
	background-color: #fff;
	max-width: 80%;
	margin: auto;
}
#container{
  min-height:100vh;
  margin:0 auto;
  font-family: "M PLUS Rounded 1c";
  padding:20px 0 40px;
}
#container > .header{
	background-color: #ccc;
	display: flex;
	justify-content:space-between;
	padding: 10px;
}
#container > .header > a{
	width:80px;
	height:40px;
	font-size: 30px;
	text-align:center;
	align-items:center;
	text-decoration:none;
}
h1{
	width:80%;
	height:50px;
	font-size: 30px;
	text-align: center;
	margin:0;
	align-items:center;
}

/* calendar */
#calendar{
	width:100%;
	margin: auto;
	border-collapse: collapse;
	border-spacing: 0;
	background-color: #f3f3f3;
}
#calendar > td{
	border:1px solid #333!important;
	text-align: center;
	font-size:20px;
	padding: 0;
}
#calendar > th,td{
	border:1px solid #333;
	text-align: center;
	font-size:20px;
	padding: 0;
}
tr *:first-child{
  color:#ff69b4;
}
tr *:last-child{
  color:#0ba9ea;
}
td.today{
	background:#ffff80;
}